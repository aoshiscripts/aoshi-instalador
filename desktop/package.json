{
  "name": "aoshi-pro-desktop",
  "productName": "Aoshi Pro",
  "version": "1.5.6",
  "description": "Navegador do Aoshi Pro: abas com proxy próprio e o Aoshi Pro já embutido, sempre atualizado.",
  "author": "aoshiscripts",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "socks": "2.8.10"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.aoshi.pro.desktop",
    "productName": "Aoshi Pro",
    "artifactName": "AoshiPro-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Aoshi Pro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aoshiscripts",
        "repo": "aoshi-instalador",
        "releaseType": "release"
      }
    ]
  }
}
